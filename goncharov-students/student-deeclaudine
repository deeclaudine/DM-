        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "np.random.seed(2024)\n",
        "\n",
        "n = 3000\n",
        "\n",
        "cities = [\"Москва\", \"Санкт-Петербург\", \"Казань\", \"Екатеринбург\", \"Челябинск\"]\n",
        "categories = [\"Электроника\", \"Одежда\", \"Дом\", \"Красота\", \"Спорт\"]\n",
        "statuses = [\"Доставлен\", \"Отменён\", \"Возврат\"]\n",
        "payments = [\"Карта\", \"Онлайн\", \"Наличные\"]\n",
        "product_names = [\n",
        "    \"Смартфон\", \"Ноутбук\", \"Наушники\", \"Футболка\", \"Джинсы\", \"Куртка\",\n",
        "    \"Пылесос\", \"Постельное бельё\", \"Помада\", \"Крем\", \"Мяч\", \"Гантели\",\n",
        "    \"Телевизор\", \"Планшет\", \"Кроссовки\", \"Пальто\", \"Чайник\", \"Подушка\",\n",
        "    \"Тушь\", \"Шампунь\", \"Велосипед\", \"Скакалка\"\n",
        "]\n",
        "\n",
        "data = {\n",
        "    \"order_id\": range(1, n + 1),\n",
        "    \"order_date\": pd.date_range(start=\"2023-01-01\", periods=n, freq=\"h\"),\n",
        "    \"customer_id\": np.random.randint(1, 500, size=n),\n",
        "    \"city\": np.random.choice(cities, size=n, p=[0.35, 0.25, 0.15, 0.15, 0.10]),\n",
        "    \"age\": np.random.randint(16, 70, size=n),\n",
        "    \"is_vip\": np.random.choice([True, False], size=n, p=[0.2, 0.8]),\n",
        "    \"product_name\": np.random.choice(product_names, size=n),\n",
        "    \"category\": np.random.choice(categories, size=n),\n",
        "    \"quantity\": np.random.randint(1, 6, size=n),\n",
        "    \"price\": np.random.randint(300, 15000, size=n),\n",
        "    \"discount\": np.round(np.random.uniform(0, 0.5, size=n), 2),\n",
        "    \"cost\": np.random.randint(200, 10000, size=n),\n",
        "    \"status\": np.random.choice(statuses, size=n, p=[0.75, 0.15, 0.10]),\n",
        "    \"payment\": np.random.choice(payments, size=n, p=[0.5, 0.35, 0.15])\n",
        "}\n",
        "\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Добавляем ~30 пропусков в age\n",
        "missing_idx = np.random.choice(n, size=30, replace=False)\n",
        "df.loc[missing_idx, \"age\"] = np.nan\n",
        "\n",
        "print(f\"DataFrame создан: {df.shape[0]} строк, {df.shape[1]} столбцов\")\n",
        "df.head()"
      ]
    },
